{
	"name": "react-to-scorm",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"build:once": "vite build && node set-manifest-default.js && node zip.js",
		"package:en": "cross-env BUILD_LANG=en npm run build:once",
		"package:fr": "cross-env BUILD_LANG=fr npm run build:once",
		"package": "npm run package:en && npm run package:fr",
		"lint": "eslint .",
		"preview": "vite preview"
	},
	"dependencies": {
		"@fortawesome/fontawesome-svg-core": "^7.0.0",
		"@fortawesome/free-solid-svg-icons": "^7.0.0",
		"@fortawesome/react-fontawesome": "^0.2.3",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-helmet-async": "^2.0.5"
	},
	"devDependencies": {
		"@eslint/js": "^9.15.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"@vitejs/plugin-react-swc": "^3.5.0",
		"archiver": "^7.0.1",
		"cross-env": "^10.0.0",
		"eslint": "^9.15.0",
		"eslint-plugin-react": "^7.37.2",
		"eslint-plugin-react-hooks": "^5.0.0",
		"eslint-plugin-react-refresh": "^0.4.14",
		"globals": "^15.12.0",
		"vite": "^6.0.1",
		"vite-plugin-svgr": "^4.3.0"
	}
}
